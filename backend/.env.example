# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Primary model required by the assignment
GROQ_PRIMARY_MODEL=gemma2-9b-it
# Larger fallback model, used if the primary model's output fails validation
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# SQLite by default so the grader can run this with zero setup.
# Swap to Postgres/MySQL for "production": e.g.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/complaints
DATABASE_URL=sqlite:///./complaints.db

CORS_ORIGINS=http://localhost:3000
